# local (default) → Docker Postgres; remote → Neon only
NEON_ENV=local
LOCAL_DATABASE_URL=postgres://app_db_local_user:pass@127.0.0.1:5432/app_db_local
# Set only for prod / explicit remote work. Never point local seeds at this.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=3000

# Frontend rewrite target (also set in frontend/.env.local — Next loads env from frontend/)
API_URL=http://localhost:3000
